<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test for platform/windows/E7VM.cs. Needs the e7vm shared library next to the binary or on the
       library path:  dotnet run --project platform/windows/test -- <dir-with-e7vm-library> -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../E7VM.cs" />
  </ItemGroup>
</Project>
