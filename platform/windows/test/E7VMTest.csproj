<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test for platform/windows/E7VM.cs against the e7vm shared library. Run:
       dotnet run (project platform/windows/test) with the directory holding the library as argument;
       see the csharp job in .github/workflows/ci.yml. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../E7VM.cs" />
  </ItemGroup>
</Project>
