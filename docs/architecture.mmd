%% e7vm architecture diagram: single source for docs/architecture-light.png and docs/architecture-dark.png.
%% Colors come from scripts/render-architecture.py (it fills in the palette marker at the end); regenerate with:
%%   python3 scripts/render-architecture.py
flowchart LR
  subgraph BUILD["🛠️  Build server"]
    direction TB
    DTS(["lib/e7.d.ts<br/>IDE + tsc types"]):::src
    TS(["app.ts<br/>TypeScript subset"]):::src
    CC["e7c compiler<br/>parse → check → codegen"]:::tool
    E7B[("app.e7b<br/>bytecode + CRC32")]:::artifact
    SIGN["Ed25519 sign<br/>(optional)"]:::tool
    SEED{{"release.seed<br/>Ed25519 private key"}}:::key
    SE7B[("app.e7b<br/>ready to ship")]:::artifact
    DTS -.-> TS
    TS --> CC
    CC --> E7B
    E7B --> SIGN
    SIGN --> SE7B
    SEED --> SIGN
  end

  BUILD == "📦 CDN / API" ==> APP

  subgraph APP["📱  Your app · Android · iOS · Windows · macOS · Linux"]
    direction TB
    HOST["Host code<br/>Kotlin · Swift · C# · C/C++"]:::host
    CAPI["C API · e7.h"]:::host
    HOST --> CAPI
    CAPI --> V1
    subgraph VM["⚙️  e7vm"]
      direction TB
      V1["① Verify signature<br/>if keys are configured"]:::guard
      V2["② Bytecode verifier<br/>memory safety"]:::guard
      V3["③ Link natives<br/>signature-checked"]:::guard
      V4["④ Interpreter<br/>register VM · GC · budget"]:::core
      STD["Standard library<br/>String · Array · Map<br/>JSON · BigInt · Date"]:::lib
      CRY["e7:crypto · e7:encoding<br/>BearSSL · Monocypher"]:::lib
      V1 --> V2
      V2 --> V3
      V3 --> V4
      V4 <--> STD
      V4 <--> CRY
    end
    NAT["Host functions<br/>registered by the app"]:::host
    KP{{"Key provider<br/>Keychain · Keystore · DPAPI"}}:::key
    V4 <--> NAT
    CRY <--> KP
  end

%%PALETTE%%
